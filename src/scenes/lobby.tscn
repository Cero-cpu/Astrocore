[sub_resource type="Shader" id="Shader_crt"]
code = "shader_type canvas_item;
void fragment() {
	vec2 uv = SCREEN_UV;
	float vignette = uv.x * uv.y * (1.0 - uv.x) * (1.0 - uv.y);
	vignette = clamp(pow(vignette * 15.0, 0.25), 0.0, 1.0);
	float scanline = sin(uv.y * 400.0) * 0.04;
	COLOR = vec4(0.0, 0.0, 0.0, (1.0 - vignette) * 0.5 + scanline);
}"

